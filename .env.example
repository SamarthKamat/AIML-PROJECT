# Copy to .env (never commit real secrets)
# Database: MySQL in production; SQLite fallback is used when unset
DATABASE_URL=mysql+pymysql://scbb:change-me@localhost:3306/supply_chain_black_box
# JWT signing secret (long random string)
JWT_SECRET=replace-with-a-64-char-random-string
# Optional: enables Gemini function calling in the AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Application clock (latest monthly prediction timestamp available in the synthetic data)
APP_AS_OF=2025-12-01
CORS_ORIGINS=http://localhost:5173
PORT=5000
